---
import { Image } from 'astro:assets';
import avatarImage from '../assets/avatar.png';

const profile = {
	name: 'Elmano Neves Neto',
	role: 'Senior Software Engineer',
	url: 'https://elmano.com.br',
	avatar: '/avatar.png',
	company: {
		name: 'Equifax',
		url: 'http://equifax.com',
	},
	blog: {
		name: 'Frontend Production',
		url: 'http://frontendproduction.com',
	},
	social: {
		linkedin: 'https://www.linkedin.com/in/elmanoneto',
		github: 'https://www.github.com/elmanoneto',
		instagram: 'https://www.instagram.com/elmanoneto',
		contact: 'mailto:elmanoneto@gmail.com',
	},
};

const content = {
	en: {
		title: 'Elmano Neves Neto | Senior Software Engineer',
		description:
			'Senior Software Engineer at Equifax focused on scalable frontend architecture, design systems, and production-grade web applications.',
		role: 'Senior Software Engineer',
		paragraphs: [
			'Senior Software Engineer focused on scalable frontend architecture, design systems, and production-grade web applications.',
			'For over 12 years, I have been building enterprise platforms with React, TypeScript, and modern frontend engineering practices.',
			`I currently work at <a href="${profile.company.url}" target="_blank" rel="noreferrer">${profile.company.name}</a>, building financial technology products, and write about real-world frontend engineering at <a href="${profile.blog.url}" target="_blank" rel="noreferrer">${profile.blog.name}</a>.`,
		],
		resume: 'View Resume',
		resumeLabel: 'View Elmano Neves Neto resume',
		contactLabel: 'Contact Elmano Neves Neto',
	},
	pt: {
		title: 'Elmano Neves Neto | Engenheiro de Software Sênior',
		description:
			'Engenheiro de Software Sênior na Equifax, focado em arquitetura frontend escalável, design systems e aplicações web prontas para produção.',
		role: 'Engenheiro de Software Sênior',
		paragraphs: [
			'Engenheiro de Software Sênior focado em arquitetura frontend escalável, design systems e aplicações web prontas para produção.',
			'Há mais de 12 anos, construo plataformas empresariais com React, TypeScript e práticas modernas de engenharia frontend.',
			`Atualmente trabalho na <a href="${profile.company.url}" target="_blank" rel="noreferrer">${profile.company.name}</a>, desenvolvendo produtos de tecnologia financeira, e escrevo sobre engenharia frontend do mundo real na <a href="${profile.blog.url}" target="_blank" rel="noreferrer">${profile.blog.name}</a>.`,
		],
		resume: 'Ver Currículo',
		resumeLabel: 'Ver currículo de Elmano Neves Neto',
		contactLabel: 'Entrar em contato com Elmano Neves Neto',
	},
};

const defaultContent = content.en;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	jobTitle: profile.role,
	url: profile.url,
	image: `${profile.url}${profile.avatar}`,
	worksFor: {
		'@type': 'Organization',
		name: profile.company.name,
		url: profile.company.url,
	},
	sameAs: [
		profile.social.linkedin,
		profile.social.github,
		profile.social.instagram,
		profile.blog.url,
	],
	knowsAbout: [
		'Frontend Architecture',
		'React',
		'TypeScript',
		'Design Systems',
		'Web Performance',
	],
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={defaultContent.description} />
		<meta
			name="keywords"
			content="Elmano Neves Neto, Senior Software Engineer, React, TypeScript, Design Systems, Frontend Architecture"
		/>
		<meta name="author" content={profile.name} />
		<meta name="robots" content="index, follow" />
		<meta property="og:type" content="profile" />
		<meta property="og:title" content={defaultContent.title} />
		<meta property="og:description" content={defaultContent.description} />
		<meta property="og:url" content={profile.url} />
		<meta property="og:image" content={`${profile.url}${profile.avatar}`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={defaultContent.title} />
		<meta name="twitter:description" content={defaultContent.description} />
		<meta name="twitter:image" content={`${profile.url}${profile.avatar}`} />
		<link rel="canonical" href={profile.url} />
		<link rel="alternate" hreflang="en" href={profile.url} />
		<link rel="alternate" hreflang="pt-BR" href={profile.url} />
		<link rel="alternate" hreflang="x-default" href={profile.url} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<title>{defaultContent.title}</title>
	</head>
	<body>
		<main class="profile-shell" aria-labelledby="page-title">
			<section class="hero-card" aria-label="Profile">
				<div class="hero-watermark" aria-hidden="true">&lt;/&gt;</div>
				<Image
					class="avatar"
					src={avatarImage}
					alt="Portrait of Elmano Neves Neto"
					width="144"
					height="144"
					loading="eager"
				/>
				<div class="identity">
					<h1 id="page-title">{profile.name}</h1>
					<p class="role-pill" data-i18n="role">{defaultContent.role}</p>
				</div>
			</section>

			<section class="profile-grid" aria-label="Profile details">
				<div class="bio-card" aria-label="Biography">
					<p class="bio-lead" data-i18n="paragraphs.0" data-i18n-html set:html={defaultContent.paragraphs[0]} />
					<div class="bio-copy">
						{defaultContent.paragraphs.slice(1).map((paragraph, index) => (
							<p data-i18n={`paragraphs.${index + 1}`} data-i18n-html set:html={paragraph} />
						))}
					</div>
				</div>

				<div class="actions-panel">
					<a
						class="resume-button"
						href="/resume"
						data-i18n-attr="aria-label:resumeLabel"
						aria-label={defaultContent.resumeLabel}
					>
						<span class="resume-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z"></path>
								<path d="M14 2v5h5"></path>
								<path d="M9 13h6"></path>
								<path d="M9 17h6"></path>
								<path d="M9 9h1"></path>
							</svg>
						</span>
						<span data-i18n="resume">{defaultContent.resume}</span>
						<svg class="resume-arrow" aria-hidden="true" viewBox="0 0 24 24">
							<path d="M7 17 17 7"></path>
							<path d="M8 7h9v9"></path>
						</svg>
					</a>

					<nav class="social-links" aria-label="Social links">
						<a href={profile.social.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
							<svg aria-hidden="true" viewBox="0 0 24 24">
								<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
								<rect x="2" y="9" width="4" height="12"></rect>
								<circle cx="4" cy="4" r="2"></circle>
							</svg>
						</a>
						<a href={profile.social.github} target="_blank" rel="noreferrer" aria-label="GitHub">
							<svg aria-hidden="true" viewBox="0 0 24 24">
								<path d="M9 19c-5 1.5-5-2.5-7-3"></path>
								<path d="M15 22v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.1-1.5 6.1-6.7A5.2 5.2 0 0 0 18.8 5a4.8 4.8 0 0 0-.1-3.8s-1.1-.3-3.9 1.5a13.4 13.4 0 0 0-7 0C5 1 3.9 1.2 3.9 1.2A4.8 4.8 0 0 0 3.8 5a5.2 5.2 0 0 0-1.4 3.8c0 5.2 3.1 6.4 6.1 6.7a3.4 3.4 0 0 0-.9 2.6V22"></path>
							</svg>
						</a>
						<a href={profile.social.instagram} target="_blank" rel="noreferrer" aria-label="Instagram">
							<svg aria-hidden="true" viewBox="0 0 24 24">
								<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
								<path d="M16 11.4A4 4 0 1 1 12.6 8 4 4 0 0 1 16 11.4z"></path>
								<path d="M17.5 6.5h.01"></path>
							</svg>
						</a>
						<a
							href={profile.social.contact}
							data-i18n-attr="aria-label:contactLabel"
							aria-label={defaultContent.contactLabel}
						>
							<svg aria-hidden="true" viewBox="0 0 24 24">
								<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9H13a8.5 8.5 0 0 1 8 8z"></path>
							</svg>
						</a>
					</nav>
				</div>
			</section>
		</main>

		<script is:inline define:vars={{ content }}>
			const dictionary = content;
			const locale = navigator.language?.toLowerCase().startsWith('pt') ? 'pt' : 'en';
			const copy = dictionary[locale];
			const getValue = (path) => path.split('.').reduce((value, key) => value?.[key], copy);

			document.documentElement.lang = locale === 'pt' ? 'pt-BR' : 'en';
			document.title = copy.title;
			document.querySelector('meta[name="description"]')?.setAttribute('content', copy.description);
			document.querySelector('meta[property="og:title"]')?.setAttribute('content', copy.title);
			document.querySelector('meta[property="og:description"]')?.setAttribute('content', copy.description);
			document.querySelector('meta[name="twitter:title"]')?.setAttribute('content', copy.title);
			document.querySelector('meta[name="twitter:description"]')?.setAttribute('content', copy.description);

			document.querySelectorAll('[data-i18n]').forEach((element) => {
				const value = getValue(element.dataset.i18n);
				if (!value) return;
				if (element.hasAttribute('data-i18n-html')) {
					element.innerHTML = value;
					return;
				}
				element.textContent = value;
			});

			document.querySelectorAll('[data-i18n-attr]').forEach((element) => {
				const [attribute, key] = element.dataset.i18nAttr.split(':');
				const value = getValue(key);
				if (attribute && value) element.setAttribute(attribute, value);
			});
		</script>
	</body>
</html>

<style>
	:root {
		--color-page: #f6f9fc;
		--color-card: #ffffff;
		--color-ink: #101a31;
		--color-body: #43546a;
		--color-accent: #4fa8ff;
		--color-accent-strong: #2f6df6;
		--color-accent-soft: #edf3ff;
		--color-rule: #edf2f7;
		--color-icon: #4f5f72;
		--color-button: #0d2a45;
		--color-button-icon: #0d5d83;
		--space-page-x: 32px;
		--font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--color-page);
		color: var(--color-ink);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	body {
		margin: 0;
		min-width: 320px;
		background:
			radial-gradient(circle at center, rgba(16, 26, 49, 0.055) 1.4px, transparent 1.6px) 0 0 / 62px 62px,
			var(--color-page);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.profile-shell {
		width: min(100%, 1254px);
		margin: 0 auto;
		padding: 42px var(--space-page-x) 58px;
	}

	.hero-card,
	.bio-card,
	.resume-button,
	.social-links a {
		border: 1px solid rgba(255, 255, 255, 0.72);
		box-shadow: 0 1px 2px rgba(16, 26, 49, 0.025);
	}

	.hero-card {
		position: relative;
		display: flex;
		align-items: center;
		gap: 46px;
		min-height: 246px;
		overflow: hidden;
		padding: 48px 64px;
		border-radius: 34px;
		background: rgba(255, 255, 255, 0.74);
	}

	.avatar {
		position: relative;
		z-index: 1;
		width: 144px;
		height: 144px;
		flex: 0 0 144px;
		border: 6px solid #ffffff;
		border-radius: 999px;
		object-fit: cover;
		background: #9d9d9d;
		box-shadow: 0 16px 36px rgba(16, 26, 49, 0.1);
	}

	.hero-watermark {
		position: absolute;
		right: -16px;
		bottom: 24px;
		color: rgba(47, 109, 246, 0.06);
		font-size: 240px;
		line-height: 0.8;
		font-weight: 850;
		letter-spacing: -16px;
		pointer-events: none;
		user-select: none;
	}

	.identity {
		position: relative;
		z-index: 1;
	}

	.identity h1 {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(36px, 4.5vw, 56px);
		line-height: 1;
		font-weight: 850;
		letter-spacing: 0;
		color: var(--color-ink);
	}

	.role-pill {
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		margin: 18px 0 0;
		padding: 0 17px;
		border-radius: 999px;
		background: var(--color-accent-soft);
		color: var(--color-accent-strong);
		font-size: 14px;
		line-height: 1;
		font-weight: 800;
		letter-spacing: 1.4px;
		text-transform: uppercase;
	}

	.role-pill::before {
		margin-right: 12px;
		color: var(--color-accent-strong);
		font-size: 22px;
		font-weight: 800;
		content: '>';
	}

	.profile-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 384px;
		gap: 38px;
		margin-top: 34px;
	}

	.bio-card {
		min-height: 350px;
		padding: 44px 54px;
		border-radius: 34px;
		background: rgba(255, 255, 255, 0.74);
	}

	.bio-card p {
		margin: 0;
		letter-spacing: 0;
	}

	.bio-lead {
		max-width: 650px;
		color: var(--color-ink);
		font-size: 24px;
		line-height: 1.45;
		font-weight: 650;
	}

	.bio-copy {
		display: grid;
		gap: 12px;
		margin-top: 28px;
	}

	.bio-copy p {
		max-width: 680px;
		color: var(--color-body);
		font-size: 19px;
		line-height: 1.55;
		font-weight: 430;
	}

	.bio-card a {
		color: var(--color-accent);
		font-weight: 650;
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--color-accent) 32%, transparent);
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}

	.bio-card a:hover,
	.bio-card a:focus-visible {
		text-decoration-color: currentColor;
	}

	.actions-panel {
		display: grid;
		align-content: start;
		gap: 26px;
	}

	.resume-button {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		gap: 26px;
		width: 100%;
		min-height: 118px;
		padding: 24px 30px;
		border-radius: 34px;
		background: var(--color-button);
		color: #ffffff;
		font-size: 24px;
		line-height: 1.15;
		font-weight: 800;
		transition: transform 160ms ease, background-color 160ms ease;
	}

	.resume-button:hover,
	.resume-button:focus-visible {
		background: #17233d;
		transform: translateY(-1px);
	}

	.resume-button:focus-visible,
	.social-links a:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
		outline-offset: 4px;
	}

	.resume-button > span:not(.resume-icon) {
		white-space: nowrap;
	}

	.resume-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 70px;
		height: 70px;
		flex: 0 0 70px;
		border-radius: 999px;
		background: var(--color-button-icon);
		color: var(--color-accent);
	}

	svg {
		width: 1em;
		height: 1em;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	.resume-icon svg {
		width: 34px;
		height: 34px;
		stroke-width: 1.9;
	}

	.resume-arrow {
		width: 30px;
		height: 30px;
		margin-left: auto;
		color: rgba(255, 255, 255, 0.58);
		stroke-width: 2.2;
	}

	.social-links {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		align-items: center;
		gap: 18px;
		color: var(--color-icon);
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 86px;
		height: 86px;
		min-height: 0;
		justify-self: center;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.6);
		transition: color 160ms ease, transform 160ms ease;
	}

	.social-links a:hover,
	.social-links a:focus-visible {
		color: var(--color-accent);
		transform: translateY(-1px);
	}

	.social-links svg {
		width: 34px;
		height: 34px;
		stroke-width: 1.9;
	}

	@media (max-width: 1050px) {
		.profile-grid {
			grid-template-columns: 1fr;
		}

		.actions-panel {
			grid-template-columns: 1fr;
		}

		.social-links a {
			width: 82px;
			height: 82px;
		}
	}

	@media (max-width: 760px) {
		:root {
			--space-page-x: 24px;
		}

		.profile-shell {
			padding-top: 22px;
			padding-bottom: 36px;
		}

		.hero-card {
			align-items: flex-start;
			flex-direction: column;
			gap: 26px;
			min-height: 0;
			padding: 30px 26px;
			border-radius: 28px;
		}

		.hero-watermark {
			right: -34px;
			bottom: 28px;
			font-size: 154px;
			letter-spacing: -10px;
		}

		.avatar {
			width: 112px;
			height: 112px;
			flex-basis: 112px;
		}

		.identity h1 {
			font-size: 34px;
		}

		.role-pill {
			min-height: 34px;
			margin-top: 14px;
			padding: 0 16px;
			font-size: 12px;
			letter-spacing: 1.2px;
		}

		.profile-grid {
			gap: 24px;
			margin-top: 20px;
		}

		.bio-card {
			min-height: 0;
			padding: 30px 26px;
			border-radius: 28px;
		}

		.bio-lead {
			font-size: 20px;
		}

		.bio-copy {
			margin-top: 22px;
		}

		.bio-copy p {
			font-size: 17px;
		}

		.resume-button {
			min-height: 82px;
			gap: 18px;
			padding: 18px 22px;
			border-radius: 30px;
			font-size: 21px;
		}

		.resume-icon {
			width: 50px;
			height: 50px;
			flex-basis: 50px;
		}

		.social-links {
			gap: 12px;
		}

		.social-links a {
			width: 68px;
			height: 68px;
		}

		.social-links svg {
			width: 31px;
			height: 31px;
		}

	}

	@media (max-width: 520px) {
		.identity h1 {
			font-size: 30px;
		}

		.role-pill {
			max-width: 100%;
			line-height: 1.2;
			white-space: normal;
		}

		.resume-button {
			font-size: 19px;
		}

		.resume-button > span:not(.resume-icon) {
			white-space: normal;
		}

		.resume-arrow {
			display: none;
		}
	}
</style>
