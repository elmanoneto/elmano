---
const profile = {
	name: 'Elmano Neves Neto',
	role: 'Senior Frontend Engineer',
	url: 'https://elmano.com.br',
	avatar: '/avatar.png',
	company: {
		name: 'Equifax',
		url: 'http://equifax.com',
	},
	blog: {
		name: 'Frontend Production',
		url: 'http://frontendproduction.com',
	},
	social: {
		linkedin: 'https://www.linkedin.com/in/elmanoneto',
		github: 'https://www.github.com/elmanoneto',
		instagram: 'https://www.instagram.com/elmanoneto',
		contact: 'mailto:hello@elmano.com.br',
	},
};

const content = {
	en: {
		title: 'Elmano Neves Neto | Senior Frontend Engineer',
		description:
			'Senior Frontend Engineer at Equifax focused on scalable frontend architecture, design systems, and production-grade web applications.',
		role: 'Senior Frontend Engineer',
		paragraphs: [
			'Senior Frontend Engineer focused on scalable frontend architecture, design systems, and production-grade web applications.',
			'For over 12 years, I have been building enterprise platforms with React, TypeScript, and modern frontend engineering practices.',
			`I currently work at <a href="${profile.company.url}" target="_blank" rel="noreferrer">${profile.company.name}</a>, building financial technology products, and write about real-world frontend engineering at <a href="${profile.blog.url}" target="_blank" rel="noreferrer">${profile.blog.name}</a>.`,
		],
		resume: 'View Resume',
		resumeLabel: 'View Elmano Neves Neto resume',
		contactLabel: 'Contact Elmano Neves Neto',
	},
	pt: {
		title: 'Elmano Neves Neto | Engenheiro Frontend Sênior',
		description:
			'Engenheiro Frontend Sênior na Equifax, focado em arquitetura frontend escalável, design systems e aplicações web prontas para produção.',
		role: 'Engenheiro Frontend Sênior',
		paragraphs: [
			'Engenheiro Frontend Sênior focado em arquitetura frontend escalável, design systems e aplicações web prontas para produção.',
			'Há mais de 12 anos, construo plataformas empresariais com React, TypeScript e práticas modernas de engenharia frontend.',
			`Atualmente trabalho na <a href="${profile.company.url}" target="_blank" rel="noreferrer">${profile.company.name}</a>, desenvolvendo produtos de tecnologia financeira, e escrevo sobre engenharia frontend do mundo real na <a href="${profile.blog.url}" target="_blank" rel="noreferrer">${profile.blog.name}</a>.`,
		],
		resume: 'Ver Currículo',
		resumeLabel: 'Ver currículo de Elmano Neves Neto',
		contactLabel: 'Entrar em contato com Elmano Neves Neto',
	},
};

const defaultContent = content.en;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	jobTitle: profile.role,
	url: profile.url,
	image: `${profile.url}${profile.avatar}`,
	worksFor: {
		'@type': 'Organization',
		name: profile.company.name,
		url: profile.company.url,
	},
	sameAs: [
		profile.social.linkedin,
		profile.social.github,
		profile.social.instagram,
		profile.blog.url,
	],
	knowsAbout: [
		'Frontend Architecture',
		'React',
		'TypeScript',
		'Design Systems',
		'Web Performance',
	],
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={defaultContent.description} />
		<meta
			name="keywords"
			content="Elmano Neves Neto, Senior Frontend Engineer, React, TypeScript, Design Systems, Frontend Architecture"
		/>
		<meta name="author" content={profile.name} />
		<meta name="robots" content="index, follow" />
		<meta property="og:type" content="profile" />
		<meta property="og:title" content={defaultContent.title} />
		<meta property="og:description" content={defaultContent.description} />
		<meta property="og:url" content={profile.url} />
		<meta property="og:image" content={`${profile.url}${profile.avatar}`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={defaultContent.title} />
		<meta name="twitter:description" content={defaultContent.description} />
		<meta name="twitter:image" content={`${profile.url}${profile.avatar}`} />
		<link rel="canonical" href={profile.url} />
		<link rel="alternate" hreflang="en" href={profile.url} />
		<link rel="alternate" hreflang="pt-BR" href={profile.url} />
		<link rel="alternate" hreflang="x-default" href={profile.url} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<title>{defaultContent.title}</title>
	</head>
	<body>
		<main class="profile-shell" aria-labelledby="page-title">
			<section class="intro" aria-label="Profile">
				<header class="profile-heading">
					<img
						class="avatar"
						src={profile.avatar}
						alt="Portrait of Elmano Neves Neto"
						width="120"
						height="120"
					/>
					<div class="identity">
						<h1 id="page-title">{profile.name}</h1>
						<p class="role" data-i18n="role">{defaultContent.role}</p>
					</div>
				</header>

				<div class="bio" aria-label="Biography">
					{defaultContent.paragraphs.map((paragraph, index) => (
						<p data-i18n={`paragraphs.${index}`} data-i18n-html set:html={paragraph} />
					))}
				</div>
			</section>

			<footer class="actions" aria-label="Profile links">
				<a
					class="resume-button"
					href="/resume"
					data-i18n-attr="aria-label:resumeLabel"
					aria-label={defaultContent.resumeLabel}
				>
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z"></path>
						<path d="M14 2v5h5"></path>
						<path d="M9 13h6"></path>
						<path d="M9 17h6"></path>
						<path d="M9 9h1"></path>
					</svg>
					<span data-i18n="resume">{defaultContent.resume}</span>
				</a>

				<nav class="social-links" aria-label="Social links">
					<a href={profile.social.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
						<svg aria-hidden="true" viewBox="0 0 24 24">
							<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
							<rect x="2" y="9" width="4" height="12"></rect>
							<circle cx="4" cy="4" r="2"></circle>
						</svg>
					</a>
					<a href={profile.social.github} target="_blank" rel="noreferrer" aria-label="GitHub">
						<svg aria-hidden="true" viewBox="0 0 24 24">
							<path d="M9 19c-5 1.5-5-2.5-7-3"></path>
							<path d="M15 22v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.1-1.5 6.1-6.7A5.2 5.2 0 0 0 18.8 5a4.8 4.8 0 0 0-.1-3.8s-1.1-.3-3.9 1.5a13.4 13.4 0 0 0-7 0C5 1 3.9 1.2 3.9 1.2A4.8 4.8 0 0 0 3.8 5a5.2 5.2 0 0 0-1.4 3.8c0 5.2 3.1 6.4 6.1 6.7a3.4 3.4 0 0 0-.9 2.6V22"></path>
						</svg>
					</a>
					<a href={profile.social.instagram} target="_blank" rel="noreferrer" aria-label="Instagram">
						<svg aria-hidden="true" viewBox="0 0 24 24">
							<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
							<path d="M16 11.4A4 4 0 1 1 12.6 8 4 4 0 0 1 16 11.4z"></path>
							<path d="M17.5 6.5h.01"></path>
						</svg>
					</a>
					<a
						href={profile.social.contact}
						data-i18n-attr="aria-label:contactLabel"
						aria-label={defaultContent.contactLabel}
					>
						<svg aria-hidden="true" viewBox="0 0 24 24">
							<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9H13a8.5 8.5 0 0 1 8 8z"></path>
						</svg>
					</a>
				</nav>
			</footer>
		</main>

		<script is:inline define:vars={{ content }}>
			const dictionary = content;
			const locale = navigator.language?.toLowerCase().startsWith('pt') ? 'pt' : 'en';
			const copy = dictionary[locale];
			const getValue = (path) => path.split('.').reduce((value, key) => value?.[key], copy);

			document.documentElement.lang = locale === 'pt' ? 'pt-BR' : 'en';
			document.title = copy.title;
			document.querySelector('meta[name="description"]')?.setAttribute('content', copy.description);
			document.querySelector('meta[property="og:title"]')?.setAttribute('content', copy.title);
			document.querySelector('meta[property="og:description"]')?.setAttribute('content', copy.description);
			document.querySelector('meta[name="twitter:title"]')?.setAttribute('content', copy.title);
			document.querySelector('meta[name="twitter:description"]')?.setAttribute('content', copy.description);

			document.querySelectorAll('[data-i18n]').forEach((element) => {
				const value = getValue(element.dataset.i18n);
				if (!value) return;
				if (element.hasAttribute('data-i18n-html')) {
					element.innerHTML = value;
					return;
				}
				element.textContent = value;
			});

			document.querySelectorAll('[data-i18n-attr]').forEach((element) => {
				const [attribute, key] = element.dataset.i18nAttr.split(':');
				const value = getValue(key);
				if (attribute && value) element.setAttribute(attribute, value);
			});
		</script>
	</body>
</html>

<style>
	:root {
		--color-page: #f6f9fc;
		--color-ink: #101a31;
		--color-body: #424a5d;
		--color-accent: #4fa8ff;
		--color-rule: #ecedf2;
		--color-icon: #68778f;
		--color-button: #101a31;
		--space-page-x: 32px;
		--font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--color-page);
		color: var(--color-ink);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	body {
		margin: 0;
		min-width: 320px;
		background: var(--color-page);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.profile-shell {
		width: min(100%, 886px);
		margin: 0 auto;
		padding: 108px var(--space-page-x) 84px;
	}

	.intro {
		border-bottom: 1px solid var(--color-rule);
		padding-bottom: 72px;
	}

	.profile-heading {
		display: flex;
		align-items: center;
		gap: 30px;
		margin-bottom: 54px;
	}

	.avatar {
		width: 120px;
		height: 120px;
		flex: 0 0 120px;
		border-radius: 999px;
		object-fit: cover;
		background: #9d9d9d;
	}

	.identity h1 {
		margin: 0 0 10px;
		font-family: var(--font-sans);
		font-size: 40px;
		line-height: 1.05;
		font-weight: 750;
		letter-spacing: 0;
		color: var(--color-ink);
	}

	.role {
		margin: 0;
		font-size: 23px;
		line-height: 1.25;
		font-weight: 500;
		letter-spacing: 0;
		color: var(--color-accent);
	}

	.bio {
		max-width: 842px;
	}

	.bio p {
		margin: 0;
		color: var(--color-body);
		font-size: 22px;
		line-height: 1.48;
		font-weight: 400;
		letter-spacing: 0;
	}

	.bio p + p {
		margin-top: 27px;
	}

	.bio a {
		color: var(--color-accent);
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--color-accent) 32%, transparent);
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}

	.bio a:hover,
	.bio a:focus-visible {
		text-decoration-color: currentColor;
	}

	.actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		padding-top: 50px;
	}

	.resume-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 18px;
		min-width: 259px;
		height: 64px;
		padding: 0 32px;
		border-radius: 15px;
		background: var(--color-button);
		color: #ffffff;
		font-size: 22px;
		line-height: 1;
		font-weight: 700;
		transition: transform 160ms ease, background-color 160ms ease;
	}

	.resume-button:hover,
	.resume-button:focus-visible {
		background: #17233d;
		transform: translateY(-1px);
	}

	.resume-button:focus-visible,
	.social-links a:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
		outline-offset: 4px;
	}

	svg {
		width: 1em;
		height: 1em;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	.resume-button svg {
		width: 28px;
		height: 28px;
		stroke-width: 2;
	}

	.social-links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 43px;
		color: var(--color-icon);
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 41px;
		height: 41px;
		border-radius: 8px;
		transition: color 160ms ease, transform 160ms ease;
	}

	.social-links a:hover,
	.social-links a:focus-visible {
		color: var(--color-accent);
		transform: translateY(-1px);
	}

	.social-links svg {
		width: 35px;
		height: 35px;
		stroke-width: 1.9;
	}

	@media (max-width: 760px) {
		:root {
			--space-page-x: 24px;
		}

		.profile-shell {
			padding-top: 52px;
			padding-bottom: 48px;
		}

		.intro {
			padding-bottom: 42px;
		}

		.profile-heading {
			gap: 22px;
			margin-bottom: 38px;
		}

		.avatar {
			width: 92px;
			height: 92px;
			flex-basis: 92px;
		}

		.identity h1 {
			font-size: 31px;
			line-height: 1.05;
		}

		.role {
			font-size: 19px;
		}

		.bio p {
			font-size: 19px;
			line-height: 1.52;
		}

		.actions {
			align-items: flex-start;
			flex-direction: column;
			padding-top: 36px;
		}

		.social-links {
			width: 100%;
			justify-content: space-between;
			gap: 18px;
		}
	}

	@media (max-width: 520px) {
		.profile-heading {
			align-items: flex-start;
			flex-direction: column;
		}

		.identity h1 {
			font-size: 34px;
		}

		.resume-button {
			width: 100%;
			min-width: 0;
		}
	}
</style>
