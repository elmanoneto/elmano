---
const profile = {
	name: 'Elmano Neves Neto',
	fullName: 'Elmano Neves Neto',
	role: 'Senior Software Engineer',
	url: 'https://elmano.com.br',
	avatar: '/avatar.png',
	location: {
		en: 'João Pessoa, Brazil',
		pt: 'João Pessoa, Brasil',
	},
	company: {
		name: 'Equifax',
		url: 'http://equifax.com',
	},
	blog: {
		name: 'Frontend Production',
		url: 'http://frontendproduction.com',
		label: 'frontendproduction.com',
	},
	social: {
		linkedin: 'https://www.linkedin.com/in/elmanoneto',
		github: 'https://www.github.com/elmanoneto',
	},
};

const content = {
	en: {
		title: 'Resume | Elmano Neto',
		description:
			'Resume of Elmano Neto, Senior Software Engineer focused on scalable frontend architecture, design systems, React, TypeScript, and production-grade web applications.',
		role: 'Senior Software Engineer',
		location: profile.location.en,
		linkedin: 'LinkedIn',
		educationTitle: 'Education',
		educationDegree: "Bachelor's Degree in Information Systems",
		educationSchool: 'Universidade Federal da Paraíba',
		skillsTitle: 'Technical Skills',
		skillGroups: [
			{
				title: 'Languages & Frameworks',
				items: 'React.js, TypeScript, JavaScript (ES6+), Next.js, Node.js',
			},
			{
				title: 'Architecture',
				items: 'Frontend Architecture, Design Systems, Scalable Frontend Systems, Component Composition',
			},
			{
				title: 'Libraries & Tools',
				items: 'React Query, Material UI (MUI), TailwindCSS, CI/CD, GitLab CI, Docker',
			},
			{
				title: 'Backend & Data',
				items: 'REST APIs, PostgreSQL, MongoDB, Redis, FastAPI',
			},
		],
		summaryTitle: 'Professional Summary',
		summary: [
			'Senior Software Engineer with 12+ years of experience building scalable web applications, enterprise systems, and production-grade digital products.',
			'Specialized in React, TypeScript, JavaScript, and modern frontend architecture, with strong expertise in design systems, component-driven development, performance optimization, and developer experience.',
			'Experienced in financial systems, credit-reporting products, and large-scale enterprise platforms, working closely with product, backend, and UX teams to deliver maintainable and scalable solutions.',
			'Strong engineering mindset with focus on architecture decisions, frontend scalability, reusable systems, technical quality, and long-term maintainability. Currently also focused on topics such as AI, data engineering, streaming architectures, and modern software engineering practices.',
		],
		experienceTitle: 'Professional Experience',
		experience: [
			{
				role: 'Senior Software Engineer',
				company: 'Boa Vista / Equifax',
				period: 'Current',
				active: true,
				bullets: [
					'Developing enterprise-grade financial and credit-reporting applications used in production environments.',
					'Designing scalable frontend architectures with React, TypeScript, and modern component-driven patterns.',
					'Leading initiatives around design systems, frontend consistency, and reusable UI infrastructure.',
					'Working closely with backend, product, and UX teams on technical discovery and architecture decisions.',
					'Improving frontend maintainability, performance, and developer productivity.',
					'Mentoring developers and supporting technical decision-making across the team.',
					'Implementing advanced state management and data-fetching strategies with React Query.',
				],
			},
			{
				role: 'Frontend Engineer',
				company: '(Previous professional experiences from LinkedIn)',
				period: '',
				active: false,
				bullets: [
					'Worked on frontend applications focused on scalability, maintainability, and user experience.',
					'Built reusable component libraries and internal frontend standards.',
					'Collaborated in agile environments with multidisciplinary teams.',
					'Participated in architecture discussions and technical solution design.',
					'Delivered modern interfaces using React ecosystem technologies.',
				],
			},
		],
		initiativeTitle: 'Highlighted Initiative',
		initiativeName: 'Frontend Production',
		initiativeDescription:
			'Technical blog focused on real-world frontend engineering challenges, architecture decisions, scalability, design systems, and production-ready frontend patterns. The platform shares practical lessons learned from building enterprise applications, avoiding beginner-level tutorials and focusing on engineering depth and real production scenarios.',
		initiativeTags: [
			'Design Systems at Scale',
			'Frontend Architecture',
			'Performance Optimization',
			'React Patterns',
			'DX Improvements',
			'Enterprise Frontend Engineering',
		],
	},
	pt: {
		title: 'Currículo | Elmano Neto',
		description:
			'Currículo de Elmano Neto, Engenheiro de Software Sênior focado em arquitetura frontend escalável, design systems, React, TypeScript e aplicações web prontas para produção.',
		role: 'Engenheiro de Software Sênior',
		location: profile.location.pt,
		linkedin: 'LinkedIn',
		educationTitle: 'Formação',
		educationDegree: 'Bacharelado em Sistemas de Informação',
		educationSchool: 'Universidade Federal da Paraíba',
		skillsTitle: 'Competências Técnicas',
		skillGroups: [
			{
				title: 'Linguagens & Frameworks',
				items: 'React.js, TypeScript, JavaScript (ES6+), Next.js, Node.js',
			},
			{
				title: 'Arquitetura',
				items: 'Arquitetura Frontend, Design Systems, Sistemas Frontend Escaláveis, Composição de Componentes',
			},
			{
				title: 'Bibliotecas & Ferramentas',
				items: 'React Query, Material UI (MUI), TailwindCSS, CI/CD, GitLab CI, Docker',
			},
			{
				title: 'Backend & Dados',
				items: 'REST APIs, PostgreSQL, MongoDB, Redis, FastAPI',
			},
		],
		summaryTitle: 'Resumo Profissional',
		summary: [
			'Engenheiro de Software Sênior com mais de 12 anos de experiência construindo aplicações web escaláveis, sistemas empresariais e produtos digitais prontos para produção.',
			'Especializado em React, TypeScript, JavaScript e arquitetura frontend moderna, com forte experiência em design systems, desenvolvimento orientado a componentes, otimização de performance e experiência do desenvolvedor.',
			'Experiência em sistemas financeiros, produtos de análise de crédito e plataformas empresariais de grande escala, trabalhando em parceria com times de produto, backend e UX para entregar soluções manuteníveis e escaláveis.',
			'Mentalidade forte de engenharia, com foco em decisões de arquitetura, escalabilidade frontend, sistemas reutilizáveis, qualidade técnica e manutenibilidade de longo prazo. Atualmente também focado em temas como IA, engenharia de dados, arquiteturas de streaming e práticas modernas de engenharia de software.',
		],
		experienceTitle: 'Experiência Profissional',
		experience: [
			{
				role: 'Engenheiro de Software Sênior',
				company: 'Boa Vista / Equifax',
				period: 'Atual',
				active: true,
				bullets: [
					'Desenvolvimento de aplicações financeiras e de análise de crédito de nível empresarial usadas em ambientes de produção.',
					'Desenho de arquiteturas frontend escaláveis com React, TypeScript e padrões modernos orientados a componentes.',
					'Liderança de iniciativas em design systems, consistência frontend e infraestrutura reutilizável de UI.',
					'Colaboração próxima com times de backend, produto e UX em descobertas técnicas e decisões de arquitetura.',
					'Evolução da manutenibilidade, performance e produtividade de desenvolvimento no frontend.',
					'Mentoria de desenvolvedores e apoio à tomada de decisões técnicas no time.',
					'Implementação de estratégias avançadas de gerenciamento de estado e busca de dados com React Query.',
				],
			},
			{
				role: 'Engenheiro Frontend',
				company: '(Experiências profissionais anteriores no LinkedIn)',
				period: '',
				active: false,
				bullets: [
					'Atuação em aplicações frontend com foco em escalabilidade, manutenibilidade e experiência do usuário.',
					'Construção de bibliotecas de componentes reutilizáveis e padrões internos de frontend.',
					'Colaboração em ambientes ágeis com times multidisciplinares.',
					'Participação em discussões de arquitetura e desenho de soluções técnicas.',
					'Entrega de interfaces modernas usando tecnologias do ecossistema React.',
				],
			},
		],
		initiativeTitle: 'Iniciativa em Destaque',
		initiativeName: 'Frontend Production',
		initiativeDescription:
			'Blog técnico focado em desafios reais de engenharia frontend, decisões de arquitetura, escalabilidade, design systems e padrões frontend prontos para produção. A plataforma compartilha lições práticas aprendidas na construção de aplicações empresariais, evitando tutoriais introdutórios e priorizando profundidade técnica e cenários reais de produção.',
		initiativeTags: [
			'Design Systems em Escala',
			'Arquitetura Frontend',
			'Otimização de Performance',
			'Padrões React',
			'Melhorias de DX',
			'Frontend Empresarial',
		],
	},
};

const defaultContent = content.en;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	name: defaultContent.title,
	description: defaultContent.description,
	url: `${profile.url}/resume`,
	mainEntity: {
		'@type': 'Person',
		name: profile.fullName,
		jobTitle: profile.role,
		image: `${profile.url}${profile.avatar}`,
		worksFor: {
			'@type': 'Organization',
			name: profile.company.name,
			url: profile.company.url,
		},
		sameAs: [
			profile.social.linkedin,
			profile.social.github,
			profile.blog.url,
		],
	},
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={defaultContent.description} />
		<meta name="author" content={profile.fullName} />
		<meta name="robots" content="index, follow" />
		<meta property="og:type" content="profile" />
		<meta property="og:title" content={defaultContent.title} />
		<meta property="og:description" content={defaultContent.description} />
		<meta property="og:url" content={`${profile.url}/resume`} />
		<meta property="og:image" content={`${profile.url}${profile.avatar}`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={defaultContent.title} />
		<meta name="twitter:description" content={defaultContent.description} />
		<meta name="twitter:image" content={`${profile.url}${profile.avatar}`} />
		<link rel="canonical" href={`${profile.url}/resume`} />
		<link rel="alternate" hreflang="en" href={`${profile.url}/resume`} />
		<link rel="alternate" hreflang="pt-BR" href={`${profile.url}/resume`} />
		<link rel="alternate" hreflang="x-default" href={`${profile.url}/resume`} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<title>{defaultContent.title}</title>
	</head>
	<body>
		<main class="resume-page" aria-labelledby="resume-title">
			<div class="resume-card">
				<aside class="sidebar" aria-label="Resume details">
					<header class="person">
						<h1 id="resume-title">{profile.name}</h1>
						<p data-i18n="role">{defaultContent.role}</p>
					</header>

					<ul class="contact-list" aria-label="Contact links">
						<li>
							<span aria-hidden="true">📍</span>
							<span data-i18n="location">{defaultContent.location}</span>
						</li>
						<li>
							<span aria-hidden="true">🌐</span>
							<a href={profile.social.linkedin} target="_blank" rel="noreferrer" data-i18n="linkedin">
								{defaultContent.linkedin}
							</a>
						</li>
					</ul>

					<section class="side-section" aria-labelledby="education-title">
						<h2 id="education-title" data-i18n="educationTitle">{defaultContent.educationTitle}</h2>
						<h3 data-i18n="educationDegree">{defaultContent.educationDegree}</h3>
						<p data-i18n="educationSchool">{defaultContent.educationSchool}</p>
					</section>

					<section class="side-section" aria-labelledby="skills-title">
						<h2 id="skills-title" data-i18n="skillsTitle">{defaultContent.skillsTitle}</h2>
						<div class="skill-groups">
							{defaultContent.skillGroups.map((group, index) => (
								<div class="skill-group">
									<h3 data-i18n={`skillGroups.${index}.title`}>{group.title}</h3>
									<p data-i18n={`skillGroups.${index}.items`}>{group.items}</p>
								</div>
							))}
						</div>
					</section>
				</aside>

				<div class="content">
					<section class="main-section" aria-labelledby="summary-title">
						<h2 id="summary-title" data-i18n="summaryTitle">{defaultContent.summaryTitle}</h2>
						<div class="summary-copy">
							{defaultContent.summary.map((paragraph, index) => (
								<p data-i18n={`summary.${index}`}>{paragraph}</p>
							))}
						</div>
					</section>

					<section class="main-section" aria-labelledby="experience-title">
						<h2 id="experience-title" data-i18n="experienceTitle">{defaultContent.experienceTitle}</h2>
						<div class="timeline">
							{defaultContent.experience.map((item, index) => (
								<article class:list={['timeline-item', { active: item.active }]}>
									<div class="experience-heading">
										<div>
											<h3 data-i18n={`experience.${index}.role`}>{item.role}</h3>
											<p class="company" data-i18n={`experience.${index}.company`}>{item.company}</p>
										</div>
										{item.period && (
											<span class="period" data-i18n={`experience.${index}.period`}>{item.period}</span>
										)}
									</div>
									<ul>
										{item.bullets.map((bullet, bulletIndex) => (
											<li data-i18n={`experience.${index}.bullets.${bulletIndex}`}>{bullet}</li>
										))}
									</ul>
								</article>
							))}
						</div>
					</section>

					<section class="main-section initiative-section" aria-labelledby="initiative-title">
						<h2 id="initiative-title" data-i18n="initiativeTitle">{defaultContent.initiativeTitle}</h2>
						<article class="initiative-card">
							<div class="initiative-heading">
								<h3 data-i18n="initiativeName">{defaultContent.initiativeName}</h3>
								<a href={profile.blog.url} target="_blank" rel="noreferrer">
									{profile.blog.label}
									<span aria-hidden="true">↗</span>
								</a>
							</div>
							<p data-i18n="initiativeDescription">{defaultContent.initiativeDescription}</p>
							<ul class="tag-list">
								{defaultContent.initiativeTags.map((tag, index) => (
									<li data-i18n={`initiativeTags.${index}`}>{tag}</li>
								))}
							</ul>
						</article>
					</section>
				</div>
			</div>
		</main>

		<script is:inline define:vars={{ content }}>
			const dictionary = content;
			const locale = navigator.language?.toLowerCase().startsWith('pt') ? 'pt' : 'en';
			const copy = dictionary[locale];
			const getValue = (path) => path.split('.').reduce((value, key) => value?.[key], copy);

			document.documentElement.lang = locale === 'pt' ? 'pt-BR' : 'en';
			document.title = copy.title;
			document.querySelector('meta[name="description"]')?.setAttribute('content', copy.description);
			document.querySelector('meta[property="og:title"]')?.setAttribute('content', copy.title);
			document.querySelector('meta[property="og:description"]')?.setAttribute('content', copy.description);
			document.querySelector('meta[name="twitter:title"]')?.setAttribute('content', copy.title);
			document.querySelector('meta[name="twitter:description"]')?.setAttribute('content', copy.description);

			document.querySelectorAll('[data-i18n]').forEach((element) => {
				const value = getValue(element.dataset.i18n);
				if (value) element.textContent = value;
			});
		</script>
	</body>
</html>

<style>
	:root {
		--color-page: #f6f9fc;
		--color-panel: #ffffff;
		--color-sidebar: #f8fbff;
		--color-ink: #10263f;
		--color-body: #52647a;
		--color-muted: #91a0b2;
		--color-accent: #18c9f4;
		--color-rule: #dde7f0;
		--color-pill: #f1f5f9;
		--space-page-x: 32px;
		--font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--color-page);
		color: var(--color-ink);
		font-family: var(--font-sans);
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	body {
		margin: 0;
		min-width: 320px;
		background: var(--color-page);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	h1,
	h2,
	h3,
	p {
		margin: 0;
	}

	.resume-page {
		width: 100%;
		padding: 56px var(--space-page-x);
	}

	.resume-card {
		display: grid;
		grid-template-columns: 390px minmax(0, 1fr);
		width: min(100%, 1370px);
		margin: 0 auto;
		overflow: hidden;
		border: 1px solid var(--color-rule);
		border-radius: 14px;
		background: var(--color-panel);
		box-shadow: 0 1px 3px rgba(16, 38, 63, 0.04);
	}

	.sidebar {
		min-height: 100%;
		padding: 44px 42px;
		border-right: 1px solid var(--color-rule);
		background: var(--color-sidebar);
	}

	.person h1 {
		color: var(--color-ink);
		font-size: 31px;
		line-height: 1.08;
		font-weight: 800;
		letter-spacing: 0;
	}

	.person p {
		margin-top: 14px;
		color: var(--color-accent);
		font-size: 16px;
		line-height: 1.25;
		font-weight: 800;
		letter-spacing: 1px;
		text-transform: uppercase;
	}

	.contact-list {
		display: grid;
		gap: 14px;
		margin: 38px 0 0;
		padding: 0;
		list-style: none;
	}

	.contact-list li {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--color-body);
		font-size: 16px;
		line-height: 1.35;
		font-weight: 650;
	}

	.contact-list span[aria-hidden='true'] {
		width: 16px;
		font-size: 14px;
		text-align: center;
	}

	.contact-list a:hover,
	.contact-list a:focus-visible,
	.initiative-heading a:hover,
	.initiative-heading a:focus-visible {
		color: var(--color-accent);
	}

	.side-section {
		margin-top: 52px;
	}

	.side-section h2 {
		margin-bottom: 18px;
		color: var(--color-muted);
		font-size: 14px;
		line-height: 1.2;
		font-weight: 800;
		letter-spacing: 0.8px;
		text-transform: uppercase;
	}

	.side-section h3,
	.skill-group h3 {
		color: var(--color-ink);
		font-size: 16px;
		line-height: 1.35;
		font-weight: 800;
	}

	.side-section p,
	.skill-group p {
		margin-top: 8px;
		color: var(--color-body);
		font-size: 15px;
		line-height: 1.55;
		font-weight: 500;
	}

	.skill-groups {
		display: grid;
		gap: 24px;
	}

	.content {
		padding: 50px 54px 56px;
	}

	.main-section + .main-section {
		margin-top: 48px;
	}

	.main-section > h2 {
		margin-bottom: 22px;
		padding-bottom: 14px;
		border-bottom: 1px solid var(--color-rule);
		color: var(--color-ink);
		font-size: 29px;
		line-height: 1.15;
		font-weight: 800;
		letter-spacing: 0;
	}

	.summary-copy {
		display: grid;
		gap: 25px;
	}

	.summary-copy p,
	.timeline li,
	.initiative-card p {
		color: var(--color-body);
		font-size: 17px;
		line-height: 1.55;
		font-weight: 500;
	}

	.timeline {
		display: grid;
		gap: 42px;
	}

	.timeline-item {
		position: relative;
		padding-left: 28px;
	}

	.timeline-item::before {
		position: absolute;
		top: 8px;
		left: 0;
		width: 9px;
		height: 9px;
		border-radius: 999px;
		background: #e1e8f0;
		content: '';
	}

	.timeline-item.active::before {
		background: var(--color-accent);
	}

	.experience-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 24px;
	}

	.experience-heading h3 {
		color: var(--color-ink);
		font-size: 22px;
		line-height: 1.2;
		font-weight: 800;
	}

	.company {
		margin-top: 8px;
		color: var(--color-accent);
		font-size: 17px;
		line-height: 1.3;
		font-weight: 800;
	}

	.period {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 76px;
		height: 27px;
		padding: 0 14px;
		border-radius: 7px;
		background: var(--color-pill);
		color: #2b3a4d;
		font-size: 14px;
		line-height: 1;
		font-weight: 750;
	}

	.timeline ul {
		display: grid;
		gap: 12px;
		margin: 0;
		padding: 0 0 0 26px;
	}

	.timeline li {
		padding-left: 6px;
	}

	.initiative-card {
		padding: 32px 32px 30px;
		border: 1px solid var(--color-rule);
		border-radius: 8px;
		background: #f8fbff;
	}

	.initiative-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 20px;
	}

	.initiative-heading h3 {
		color: var(--color-ink);
		font-size: 22px;
		line-height: 1.2;
		font-weight: 800;
	}

	.initiative-heading a {
		color: var(--color-accent);
		font-size: 16px;
		line-height: 1.3;
		font-weight: 800;
		white-space: nowrap;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 12px;
		margin: 24px 0 0;
		padding: 0;
		list-style: none;
	}

	.tag-list li {
		padding: 7px 11px;
		border: 1px solid var(--color-rule);
		border-radius: 5px;
		background: var(--color-panel);
		color: var(--color-ink);
		font-size: 13px;
		line-height: 1;
		font-weight: 750;
	}

	@media (max-width: 980px) {
		.resume-card {
			grid-template-columns: 1fr;
		}

		.sidebar {
			border-right: 0;
			border-bottom: 1px solid var(--color-rule);
		}
